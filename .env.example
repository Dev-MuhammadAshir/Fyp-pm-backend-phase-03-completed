# Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# PostgreSQL (Prisma)
DATABASE_URL= fyp_user:fyp_dev_password@127.0.0.1:5433/fyp_pm?schema=public

# Redis 7
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=true

# Authentication & JWT
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_SALT_ROUNDS=12

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Storage (Local / S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# PIRAE Configuration (Advisory Engine)
PIRAE_WORKLOAD_LOW_THRESHOLD=0.70
PIRAE_WORKLOAD_MED_THRESHOLD=0.90
PIRAE_WORKLOAD_HIGH_THRESHOLD=1.20
